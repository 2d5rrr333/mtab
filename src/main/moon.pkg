// mtab wasm FFI surface (design D1/D2): the only package in the web artifact.
//
// Exports mtab_init/mtab_dispatch over the moonbridge Session. JS
// passes/stores config JSON text; responses are the state+effects
// envelope. All protocol mechanics live in 2d5rrr333/moonbridge.

import {
  "2d5rrr333/moonbridge/bridge",
  "2d5rrr333/mtab/store",
  "moonbitlang/core/json",
}

pkgtype(kind: "foreign_library")

options(
  link: { "wasm-gc": { "use-js-builtin-string": true } },
)
